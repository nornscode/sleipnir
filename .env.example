# Norns server
NORNS_URL=http://localhost:4000
NORNS_API_KEY=

# LLM provider (read by LiteLLM inside the SDK)
ANTHROPIC_API_KEY=

# Optional: pin this worker to a gard so tool calls for its runs only
# ever reach this machine. `nornsctl gards create` prints both.
# NORNS_GARD=
# NORNS_GARD_CLAIM_TOKEN=

# Optional overrides
# SLEIPNIR_AGENT=sleipnir
# SLEIPNIR_MODEL=claude-sonnet-5
